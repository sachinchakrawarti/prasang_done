{
  "save": {
    "defaultMessagePrefix": "save:",
    "autoStage": true,
    "pullStrategy": "rebase-autostash",
    "pushOnCommit": true
  },
  "watch": {
    "debounceMs": 30000,
    "paths": [
      "server/**/*.{js,mjs,json}",
      "web/src/**/*.{js,jsx,ts,tsx,css}",
      "db/schema/**/*.js",
      "db/automation/**/*.js",
      "commitflow/**/*.js",
      "*.md"
    ],
    "ignored": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/dist/**",
      "**/.git/**",
      "**/*.db",
      "**/*.db-*",
      "commitflow/logs/**"
    ]
  },
  "logging": {
    "enabled": true,
    "console": true,
    "file": true,
    "maxLogSizeMb": 5
  }
}